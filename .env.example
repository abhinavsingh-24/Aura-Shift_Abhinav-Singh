# Copy this file to `.env` in the project root and fill in real values. Never commit `.env`.

# Port for the Express API. The Vite dev server proxies /api to http://localhost:3001,
# so if you change this, change `server.proxy` in client/vite.config.js too.
PORT=3001

# MongoDB connection string, e.g. mongodb+srv://<user>:<password>@<cluster>/<database>
# Leave EMPTY to run in demo mode: data lives in memory and resets on every restart.
MONGO_URI=

# Origin of the frontend (used for CORS).
FRONTEND_URL=http://localhost:5173

# Signs login cookies. In production this MUST be a random string of 32+ characters
# (generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
SESSION_SECRET=replace-with-a-long-random-secret-before-deployment

# Production checklist: use HTTPS, set a random SESSION_SECRET (32+ chars),
# configure FRONTEND_URL to the exact deployed origin, and provide MONGO_URI.
# Rate limits are process-local; use a shared store if running multiple API instances.
