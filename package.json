{
  "name": "sidequest",
  "version": "1.0.0",
  "description": "Hyperlocal event discovery platform",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npm run dev -- --host 0.0.0.0",
    "test": "node --test server/*.test.js client/src/lib/*.test.js"
  },
  "keywords": [
    "events",
    "hackathon",
    "community",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  }
}
